{
  "name": "universal-csv-processor",
  "version": "1.0.0",
  "description": "Universal CSV processor and visualizer for any type of data",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "start-all": "nodemon server.js",
    "client": "cd ../Graph-Frontend && npm run serve",
    "build": "cd ../Graph-Frontend && npm run build",
    "install-all": "npm install && cd ../Graph-Frontend && npm install"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "express": "^4.18.2",
    "form-data": "^4.0.4",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "vue",
    "csv",
    "data-processing",
    "data-visualization",
    "universal"
  ],
  "author": "Your Name",
  "license": "MIT"
}
